# ==========================================
# 1. 机场订阅
# ==========================================

subscription {
    良心云机场: 'http://192.168.5.5:3001/T3B9dgzBzdRbBF888432/download/%E8%89%AF%E5%BF%83%E4%BA%91%E6%9C%BA%E5%9C%BA?target=ClashMeta' {
        ua: 'clash.meta/1.19.30'
        interval: 86400s
        cache: false
        route: direct
    }

    老狗机场: 'http://192.168.5.5:3001/T3B9dgzBzdRbBF888432/download/%E8%80%81%E7%8B%97%E6%9C%BA%E5%9C%BA?target=ClashMeta' {
        ua: 'clash.meta/1.19.30'
        interval: 86400s
        cache: false
        route: direct
    }

    牛逼机场: 'http://192.168.5.5:3001/T3B9dgzBzdRbBF888432/download/%E7%89%9B%E9%80%BC%E6%9C%BA%E5%9C%BA?target=ClashMeta' {
        ua: 'clash.meta/1.19.30'
        interval: 86400s
        cache: false
        route: direct
    }

    Mitce机场: 'http://192.168.5.5:3001/T3B9dgzBzdRbBF888432/download/Mitce%E6%9C%BA%E5%9C%BA?target=ClashMeta' {
        ua: 'clash.meta/1.19.30'
        interval: 0s
        cache: false
        route: direct
    }
}

# ==========================================
# 2. 代理组
# ==========================================

# node {
#     my_vps: 'hysteria2://密码@vps.example.com:443/?sni=vps.example.com'
# }

# policy 可选 select（面板手动选，默认）/ min_moving_avg（延迟最低）/ fallback（按顺序取第一个存活）/ loadbalance（轮询）/ score（按实际连接质量评分）；final：所选节点不可用时改走的组
group {

    # 默认美国代理
    Proxy {
        filter: name(regex: '良心云 - 美国')
        policy: score
        final: block
        interrupt_connections: true
    }

    # OpenAI
    OpenAi {
        filter: name(regex: '老狗 - 美国')
        policy: select
        final: block
        interrupt_connections: true
    }

    # Gemini
    Gemini {
        filter: name(regex: '老狗 - 美国')
        policy: select
        final: block
        interrupt_connections: true
    }

    # X
    X {
        filter: name(regex: '良心云 - 美国')
        policy: score
        final: block
        interrupt_connections: true
    }

    # YouTube
    YouTube {
        filter: name(regex: '良心云 - 日本')
        policy: score
        final: block
        interrupt_connections: true
    }

    # Google
    Google {
        filter: name(regex: '良心云 - 香港')
        policy: score
        final: block
        interrupt_connections: true
    }

    # Telegram
    Telegram {
        filter: name(regex: 'Mitce - 香港|牛逼 - 香港|Mitce - 日本|牛逼 - 日本')
        policy: score
        final: block
        interrupt_connections: true
    }

    # Meta
    Meta {
        filter: name(regex: '良心云 - 香港')
        policy: score
        final: block
        interrupt_connections: true
    }

    # TikTok
    TikTok {
        filter: name(regex: '良心云 - 日本')
        policy: score
        final: block
        interrupt_connections: true
    }

    # Netflix
    Netflix {
        filter: name(regex: '良心云 - 新加坡|Mitce - 新加坡|牛逼 - 新加坡')
        policy: score
        final: block
        interrupt_connections: true
    }

    # Github
    Github {
        filter: name(regex: '良心云 - 香港')
        policy: score
        final: block
        interrupt_connections: true
    }

    # Docker
    Docker {
        filter: name(regex: '良心云 - 美国')
        policy: score
        final: block
        interrupt_connections: true
    }

    # Nintendo
    Nintendo {
        filter: name(regex: '良心云 - 日本')
        policy: score
        final: block
        interrupt_connections: true
    }

    # Apple
    Apple {
        filter: name(regex: '良心云 - 香港')
        policy: score
        final: block
        interrupt_connections: true
    }

    # 最终代理组
    Final {
        filter: name(regex: '良心云 - 香港')
        policy: score
        final: block
    }
}

# ==========================================
# 3. DNS 设置
# ==========================================

dns {
    upstream {
        # 国外 DNS：Google DoH，通过 Proxy 代理
        remote: 'https://dns.google/dns-query' -> Proxy

        # 国内 DNS：阿里 DoH，直连
        local: 'https://dns.alidns.com/dns-query' -> direct
    }

    routing {
        request {
            # 屏蔽 HTTPS/SVCB 记录
            qtype(https, svcb) -> reject

            # 屏蔽 IPv6 DNS 查询
            qtype(aaaa) -> reject

            # Google 特殊域名
            qname(suffix: googleapis.cn, suffix: xn--ngstr-lra8j.com) -> remote

            # 国内、苹果中国、局域网域名
            qname(geosite: cn, geosite: apple@cn, geosite: private) -> local

            # 国外域名
            qname(geosite: geolocation-!cn) -> remote

            # 默认国外 DNS
            fallback: remote
        }

        response {
            # 国外 DNS 返回国内 IP 时，重新使用国内 DNS 查询
            upstream(remote) && ip(geoip: cn) -> local

            fallback: accept
        }
    }
}

# ==========================================
# 4. 流量分流
# ==========================================

routing {
    
    # 国内 IP、私有 IP 直连
    dip(geoip: private, geoip: cn) && !dport(53, 853) -> direct(must)

    # 屏蔽 DoT
    dport(853) -> block

    # 屏蔽 QUIC / UDP 443
    l4proto(udp) && dport(443) -> block

    # Google 特殊域名
    domain(suffix: googleapis.cn, suffix: xn--ngstr-lra8j.com) -> Google

    # OpenAI
    domain(suffix: withgoogle.com, suffix: notebooklm.google, geosite: openai) -> OpenAi

    # Gemini
    domain(geosite: google-gemini) -> Gemini

    # X
    domain(geosite: x) -> X

    # YouTube
    domain(geosite: youtube) -> YouTube

    # Google
    domain(geosite: google) -> Google

    # Telegram
    domain(geosite: telegram) -> Telegram

    # Meta
    domain(geosite: meta) -> Meta

    # TikTok
    domain(geosite: tiktok) -> TikTok

    # Netflix
    domain(geosite: netflix) -> Netflix

    # Github
    domain(geosite: github) -> Github

    # Docker
    domain(geosite: docker) -> Docker

    # Nintendo
    domain(geosite: nintendo) -> Nintendo

    # 苹果中国直连
    domain(geosite: apple@cn) -> direct

    # 苹果其他服务
    domain(geosite: apple) -> Apple

    # 其他国外域名
    domain(geosite: geolocation-!cn) -> Proxy

    # Telegram IP
    dip(geoip: telegram) -> Telegram

    # 其他流量
    fallback: Final
}

# ==========================================
# 5. 全局设置
# ==========================================

global {
    lan_interface: br-lan
    wan_interface: auto

    data_dir: '/etc/honk'

    dial_mode: domain
    tls_implementation: utls

    bootstrap_resolver: '119.29.29.29:53'

    log_level: info

    check_interval: 30s
    check_tolerance: 50ms
}

# ==========================================
# 6. 资源下载设置
# ==========================================

assets {
    route: direct

    subscription {
        ua: 'clash.meta/1.19.30'
        interval: 0s
        cache: false
    }

    geodata {
        geosite: 'https://github.828001.xyz/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/release/geosite.dat'

        geoip: 'https://github.828001.xyz/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/release/geoip.dat'

        route: direct
    }
}

# ==========================================
# 7. 面板和缓存
# ==========================================

experimental {
    native_api {
        enabled: true
        listen: '0.0.0.0:9099'
        password_auth: true
        config_write: true
        ui: embedded
    }

    cache_file {
        enabled: true
        store_dns: true
    }
}
